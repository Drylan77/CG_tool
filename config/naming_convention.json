{
    "convention_name": "Asset Naming Convention",
    "version": "1.0.0",
    "description": "Convention de nommage des assets pour le departement modeling / surfacing.",

    "separator": "_",

    "rules": {
        "allow_only_alphanumeric": true,
        "cannot_start_with_digit": true,
        "case_sensitive_check": true,
        "max_length": 0,
        "reserved_maya_names": ["persp", "top", "front", "side", "world", "defaultLightSet", "defaultObjectSet"]
    },

    "tokens": [
        {
            "key": "name",
            "label": "Name of the object",
            "type": "text",
            "required": true,
            "default": "",
            "case": "camelCase",
            "hint": "Nom descriptif de l'objet. Ex: hand, chair, engineBlock"
        },
        {
            "key": "place",
            "label": "Place / Position",
            "type": "choice",
            "required": false,
            "default": "",
            "values": [
                {"label": "(none)", "value": ""},
                {"label": "Top", "value": "Top"},
                {"label": "Bottom", "value": "Bot"},
                {"label": "Left", "value": "L"},
                {"label": "Right", "value": "R"},
                {"label": "Center", "value": "C"},
                {"label": "Front", "value": "Fr"},
                {"label": "Back", "value": "Bk"},
                {"label": "Inner", "value": "In"},
                {"label": "Outer", "value": "Out"}
            ],
            "hint": "Position de l'objet dans l'espace / hierarchie."
        },
        {
            "key": "surface",
            "label": "Surface type",
            "type": "choice",
            "required": true,
            "default": "metal",
            "values": [
                {"label": "Metal", "value": "metal"},
                {"label": "Plastic", "value": "plastic"},
                {"label": "Glass", "value": "glass"},
                {"label": "Wood", "value": "wood"},
                {"label": "Fabric", "value": "fabric"},
                {"label": "Leather", "value": "leather"},
                {"label": "Rubber", "value": "rubber"},
                {"label": "Stone", "value": "stone"},
                {"label": "Ceramic", "value": "ceramic"},
                {"label": "Skin", "value": "skin"},
                {"label": "Concrete", "value": "concrete"},
                {"label": "Paint", "value": "paint"}
            ],
            "hint": "Type de surface / materiau principal."
        },
        {
            "key": "color",
            "label": "Color",
            "type": "choice",
            "required": false,
            "default": "",
            "values": [
                {"label": "(none)", "value": ""},
                {"label": "Grey", "value": "grey"},
                {"label": "Black", "value": "black"},
                {"label": "White", "value": "white"},
                {"label": "Red", "value": "red"},
                {"label": "Green", "value": "green"},
                {"label": "Blue", "value": "blue"},
                {"label": "Yellow", "value": "yellow"},
                {"label": "Orange", "value": "orange"},
                {"label": "Brown", "value": "brown"},
                {"label": "Silver", "value": "silver"},
                {"label": "Gold", "value": "gold"}
            ],
            "hint": "Couleur dominante de l'objet."
        },
        {
            "key": "type",
            "label": "Type",
            "type": "choice",
            "required": true,
            "default": "GEO",
            "position": "suffix",
            "values": [
                {"label": "Geometry (GEO)", "value": "GEO"},
                {"label": "Point (PT)", "value": "PT"},
                {"label": "FX", "value": "FX"},
                {"label": "Group (GRP)", "value": "GRP"},
                {"label": "Locator (LOC)", "value": "LOC"},
                {"label": "Curve (CRV)", "value": "CRV"},
                {"label": "Joint (JNT)", "value": "JNT"},
                {"label": "Control (CTRL)", "value": "CTRL"},
                {"label": "Camera (CAM)", "value": "CAM"},
                {"label": "Light (LGT)", "value": "LGT"},
                {"label": "Proxy (PROXY)", "value": "PROXY"}
            ],
            "hint": "Type de node / usage. Sert de suffixe identifiant."
        }
    ],

    "options": {
        "add_index": {
            "enabled": true,
            "label": "Add numeric index (for batch)",
            "padding": 2,
            "start": 1,
            "position": "before_suffix"
        }
    }
}
